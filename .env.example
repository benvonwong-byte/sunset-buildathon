# Copy this file to .env and paste your key after the = sign.
# .env is in .gitignore, so it never gets committed.
#
# GOOGLE_MAPS_BROWSER_KEY turns on Street View photos on the Spaces page (/space/).
# It is optional: without it the page shows lot and building plans instead.
#
# Local build with the key:   node --env-file=.env scripts/build.mjs
# Live site: add the same value as a repository secret named GOOGLE_MAPS_BROWSER_KEY
# (GitHub: Settings, Secrets and variables, Actions, New repository secret).
GOOGLE_MAPS_BROWSER_KEY=
